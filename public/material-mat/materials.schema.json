{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material Mat kit",
  "description": "What the Material Mat lays out on the table. Sizes are in centimetres, at true scale.",
  "type": "object",
  "required": ["title", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "step", "name", "purpose", "quantity", "footprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Unique id." },
        "step": { "type": "number", "description": "Order on the mat (left to right, back to front) and in step mode." },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1, "description": "Shown large for the active step in step mode." },
        "quantity": { "type": "string", "minLength": 1, "description": "Shown large on the mat." },
        "footprint": { "$ref": "#/$defs/footprint" },
        "quantityVisual": {
          "description": "Optional true-scale model of the amount, next to the outline.",
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/quantityVisual" }]
        }
      },
      "additionalProperties": false
    },
    "footprint": {
      "description": "Where the real object goes, true size in cm. A pill or rect runs left to right.",
      "oneOf": [
        {
          "type": "object",
          "required": ["shape", "diameter"],
          "properties": { "shape": { "const": "circle" }, "diameter": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["shape", "width", "depth"],
          "properties": {
            "shape": { "const": "rect" },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
            "depth": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["shape", "length", "width"],
          "properties": {
            "shape": { "const": "pill" },
            "length": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 }
          },
          "additionalProperties": false
        }
      ]
    },
    "quantityVisual": {
      "oneOf": [
        {
          "type": "object",
          "description": "A ball, e.g. the wax: diameter in cm.",
          "required": ["type", "diameter"],
          "properties": {
            "type": { "const": "sphere" },
            "diameter": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
            "color": { "$ref": "#/$defs/color" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A dome of liquid or cream with this volume in ml (½ teaspoon ≈ 2.5 ml).",
          "required": ["type", "volumeMl"],
          "properties": {
            "type": { "const": "blob" },
            "volumeMl": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
            "color": { "$ref": "#/$defs/color" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A row of drops (about 0.05 ml each unless dropMl is given).",
          "required": ["type", "count"],
          "properties": {
            "type": { "const": "drops" },
            "count": { "type": "integer", "minimum": 1, "maximum": 12 },
            "dropMl": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
            "color": { "$ref": "#/$defs/color" }
          },
          "additionalProperties": false
        }
      ]
    },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
